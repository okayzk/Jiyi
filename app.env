# The app's identity and release settings, in one place. Shell, Make and Python all
# read this file, so it holds plain KEY="value" lines only (no $, `, \ or ").
# Markdown cannot read it: the release notes, the checklist and the release skill
# repeat the name by hand.

# Also the executable, the .app, the disk image and the archive, so letters and digits only.
NAME="Jiyi"
# Changing it after a release resets every user's preferences and permissions.
BUNDLE_ID="io.github.okayzk.Jiyi"
# owner/name on GitHub.
REPOSITORY="okayzk/Jiyi"
# Three numbers; BUILD goes up by one with every release.
VERSION="0.1.0"
BUILD="1"
# One sentence each, written for its own readers, not translated.
TAGLINE_EN="A tiny menu-bar translator for macOS."
TAGLINE_ZH="macOS 菜单栏轻量翻译工具。"

# A release is tagged <TAG_PREFIX><VERSION>, for example V1.2.0.
TAG_PREFIX="v"
# The languages of .github/RELEASE_NOTES.md, each written, not translated: en, zh or both.
NOTES_LANGUAGES="en zh"
# Rows in docs/incidents.md are <INCIDENT_PREFIX>-01, -02, ...
INCIDENT_PREFIX="J"

# The notarytool keychain profile on the release machine (Scripts/notarize.sh).
NOTARY_KEYCHAIN_PROFILE="jiyi-notary"
# The self-signed certificate releases are signed with until there is a Developer ID, so
# that users keep their permissions across updates (Scripts/make_release_certificate.sh).
# One certificate can serve all of the maintainer's apps. Never replace it after a
# release: a new certificate makes every user grant the permissions again.
RELEASE_CERTIFICATE="okayzk Code Signing"
RELEASE_CERTIFICATE_SHA1="92E301BCC2AF06E141247AC5DEED2D8883C07C85"

# 1: the app updates itself with Sparkle from a signed appcast on the appcast branch.
USE_SPARKLE="1"
# The public half of the key every update is signed with (Scripts/make_update_key.sh).
# Never replace it after a release: users would stop receiving updates.
UPDATE_PUBLIC_KEY=""
